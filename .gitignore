img_ofertas/*.png
!img_ofertas/mapa_*.png

# === Python caches y temporales ===
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.venv/
venv/

# === Secretos: NUNCA versionar ===
*.env
.env.*
*credentials*
*secret*
ssh-private-keys/
*.pem
*.key

# === Archivos de sistema ===
.DS_Store
Thumbs.db
desktop.ini
*.lnk

